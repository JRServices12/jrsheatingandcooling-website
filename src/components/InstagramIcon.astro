---
// The usual Instagram look: a rounded square in the Instagram colours with a white camera outline.
interface Props { size?: number; id?: string }
const { size = 26, id = "ig-grad" } = Astro.props;
---
<svg viewBox="0 0 24 24" width={size} height={size} role="img" aria-label="Instagram" style="display:block">
  <defs>
    <linearGradient id={id} x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="#FEDA75" />
      <stop offset="0.3" stop-color="#FA7E1E" />
      <stop offset="0.55" stop-color="#D62976" />
      <stop offset="0.8" stop-color="#962FBF" />
      <stop offset="1" stop-color="#4F5BD5" />
    </linearGradient>
  </defs>
  <rect width="24" height="24" rx="6" fill={`url(#${id})`} />
  <rect x="5.2" y="5.2" width="13.6" height="13.6" rx="4" fill="none" stroke="#fff" stroke-width="1.7" />
  <circle cx="12" cy="12" r="3.2" fill="none" stroke="#fff" stroke-width="1.7" />
  <circle cx="16.2" cy="7.8" r="0.9" fill="#fff" />
</svg>
