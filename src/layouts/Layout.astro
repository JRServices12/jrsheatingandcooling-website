---
import { business, services, serviceHref, reviewSource } from "../data/business.js";
import Accreditations from "../components/Accreditations.astro";
import ServiceIcon from "../components/ServiceIcon.astro";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const pageTitle = title === "Home"
  ? `${business.name} | Boiler, Heating & Air Conditioning in ${business.region}`
  : `${title} | ${business.name}`;
const canonical = new URL(Astro.url.pathname, business.url).href;
// "Free quote" opens the quote tool with this page's job already picked.
const pageService = services.find((s) => serviceHref(s) === Astro.url.pathname);
const quoteHref = pageService?.quoteJob ? `/quote/?job=${pageService.quoteJob}` : Astro.url.pathname === "/boilers/" ? "/quote/?job=boiler" : "/quote/";

// Structured data so Google can link the site to the Business Profile.
const schema = {
  "@context": "https://schema.org",
  "@type": "HVACBusiness",
  name: business.name,
  url: business.url,
  telephone: business.phoneHref.replace("tel:", ""),
  email: business.email,
  openingHours: "Mo-Fr 08:00-17:00",
  brand: business.brands.map((b) => ({ "@type": "Brand", name: b })),
  description: `Gas Safe registered boiler, heating and air conditioning engineer covering ${business.region}.`,
  areaServed: business.areaGroups.flatMap((g) => g.towns.map((t) => ({ "@type": "Place", name: `${t}, ${g.county}` }))),
  address: { "@type": "PostalAddress", addressRegion: "London", addressCountry: "GB" },
  knowsAbout: services.map((s) => s.title),
  sameAs: [business.googleUrl, reviewSource.url].filter(Boolean),
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-7HP2LCWEXM"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-7HP2LCWEXM');
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Semi+Condensed:wght@600;700&family=Source+Sans+3:wght@400;600;700&display=swap" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <div class="topbar">
      <div class="container topbar-inner">
        <span>Gas Safe registered and F-Gas certified</span>
        <span class="topbar-right">
          <span class="topbar-areas">Covering {business.region}</span>
          <span class="topbar-logos">
            <a href="https://www.gassaferegister.co.uk/" target="_blank" rel="noopener" title="Gas Safe registered: check an engineer on the Gas Safe Register"><img class="topbar-logo" src="/logos/gas-safe.png" alt="Gas Safe registered" width="27" height="30" /></a>
            <img class="topbar-logo" src="/logos/f-gas.png" alt="REFCOM F-Gas certified" width="76" height="30" />
          </span>
        </span>
      </div>
    </div>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label={`${business.name} home`}>
          <img src="/logo.svg" alt={business.name} width="190" height="84" />
        </a>
        <nav class="main-nav" aria-label="Main">
          <div class="has-menu">
            <a href="/services/" class="menu-link" aria-haspopup="true">Services<svg class="caret" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="services-menu" aria-label="Show services">
              <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="services-menu" id="services-menu">
              {services.map((s) => (
                <a class="menu-item" href={serviceHref(s)}><ServiceIcon slug={s.slug} size={20} small /><span>{s.title}</span></a>
              ))}
              <a class="menu-all" href="/services/">All services</a>
            </div>
          </div>
          <div class="has-menu">
            <a href="/boilers/" class="menu-link" aria-haspopup="true">Boilers<svg class="caret" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
            <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="boilers-menu" aria-label="Show boiler services">
              <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="services-menu" id="boilers-menu">
              {services.filter((s) => s.boiler).map((s) => (
                <a class="menu-item" href={serviceHref(s)}><ServiceIcon slug={s.slug} size={20} small /><span>{s.title}</span></a>
              ))}
              <a class="menu-all" href="/boilers/">All about boilers</a>
            </div>
          </div>
          <a href="/air-conditioning/">Air Con</a>
          <a href="/areas/">Areas</a>
          <a href="/about/">About</a>
          <a href="/reviews/">Reviews</a>
          <a href="/work/">Our work</a>
          <a href="/blog/">Blog</a>
          <a href="/faq/">FAQ</a>
          <a href="/contact/">Contact</a>
        </nav>
        <div class="header-actions">
          <a class="btn btn-call" href={business.phoneHref}>Call {business.phone}</a>
          <a class="btn btn-quote btn-free" href={quoteHref}>Free quote</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <a class="sticky-call" href={business.phoneHref}>Call now: {business.phone}</a>
    <a class="wa-float" href={`https://wa.me/${business.whatsapp}?text=${encodeURIComponent("Hi Jordan, I found you on your website.")}`} target="_blank" rel="noopener" aria-label="Message JRS on WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg><span>WhatsApp</span></a>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <img class="footer-logo" src="/logo-white.svg" alt={business.name} width="180" height="80" />
          <p>Boiler, heating and air conditioning engineer based in {business.base}, covering {business.region}. Tidy work, every job.</p>
          <p class="gas-safe-line">Gas Safe registered and F-Gas certified</p>
          <Accreditations variant="footer" />
        </div>
        <div>
          <p class="footer-head">Services</p>
          <ul>
            {services.map((s) => <li><a href={serviceHref(s)}>{s.title}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="footer-head">Areas</p>
          <p class="footer-areas">{business.areaGroups.map((g) => g.name).join(" and ")}</p>
          <p class="footer-areas"><a href="/areas/">See every town we cover</a></p>
          <p class="footer-head" style="margin-top:16px">Help &amp; advice</p>
          <p class="footer-areas"><a href="/blog/">Blog: your questions answered</a></p>
        </div>
        <div>
          <p class="footer-head">Contact</p>
          <ul>
            <li><a href={business.phoneHref}>{business.phone}</a></li>
            <li><a href={`mailto:${business.email}`}>{business.email}</a></li>
            <li>Open {business.hoursShort}</li>
            <li>Emergency call-outs: just call</li>
            <li><a href={business.googleUrl} target="_blank" rel="noopener">Find us on Google</a></li>
            <li><a href={`https://wa.me/${business.whatsapp}`} target="_blank" rel="noopener">WhatsApp me</a></li>
            <li><a href="/quote/">Get a free quote</a></li>
          </ul>
        </div>
      </div>
      <div class="container footer-base">
        <span>&copy; {new Date().getFullYear()} {business.name}</span>
      </div>
    </footer>

    <style is:global>
      :root {
        --navy: #12324f;
        --blue: #2f7bbf;
        --sky: #e8f2fb;
        --warm: #e0651a;
        --warm-dark: #b94f0f;
        --hot: #ea5a1c;
        --cold: #2fa6e6;
        --ink: #17212b;
        --muted: #586572;
        --line: #dde4ea;
        --bg: #ffffff;
        --soft: #f5f8fb;
        --display: "Barlow Semi Condensed", "Arial Narrow", Arial, sans-serif;
        --body: "Source Sans 3", "Segoe UI", system-ui, sans-serif;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: var(--body);
        font-size: 17px;
        line-height: 1.6;
        color: var(--ink);
        background: var(--bg);
      }
      img { max-width: 100%; height: auto; }
      a { color: var(--blue); }
      h1, h2, h3 { font-family: var(--display); font-weight: 700; line-height: 1.1; text-wrap: balance; color: var(--navy); margin: 0 0 0.5em; }
      h1 { font-size: clamp(2rem, 5vw, 3.1rem); }
      h2 { font-size: clamp(1.75rem, 3.8vw, 2.5rem); }
      h3 { font-size: 1.3rem; }
      p { margin: 0 0 1em; }
      .container { max-width: 1120px; margin: 0 auto; padding: 0 20px; }
      .narrow { max-width: 760px; }

      .topbar { background: var(--navy); color: #dbe8f4; font-size: 0.88rem; }
      .topbar-inner { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-top: 6px; padding-bottom: 6px; flex-wrap: wrap; }
      .topbar-right { display: inline-flex; align-items: center; gap: 12px; }
      .topbar-logos { display: inline-flex; align-items: center; gap: 8px; }
      .topbar-logos a { display: block; line-height: 0; }
      .topbar-logo { display: block; height: 30px; width: auto; background: #fff; border-radius: 6px; padding: 3px 7px; box-sizing: content-box; }

      .site-header { background: #fff; border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 20; }
      .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 6px; padding-bottom: 6px; flex-wrap: wrap; }
      .brand { display: flex; align-items: center; text-decoration: none; flex-shrink: 0; }
      .brand img { display: block; height: 66px; width: auto; }
      .site-header .main-nav { order: 3; width: 100%; gap: 6px 24px; padding: 8px 0 6px; border-top: 1px solid var(--line); }
      .btn.btn-free { background: var(--navy); border-color: var(--navy); color: #fff; }
      .btn.btn-free:hover { background: #0c2238; }
      .main-nav { display: flex; gap: 18px; flex-wrap: wrap; }
      .main-nav a { color: var(--ink); text-decoration: none; font-weight: 600; }
      .main-nav a:hover { color: var(--blue); }
      .header-actions { display: flex; gap: 10px; align-items: center; }

      .btn { display: inline-block; text-decoration: none; font-weight: 700; padding: 11px 18px; border-radius: 8px; border: 2px solid transparent; white-space: nowrap; }
      .btn-call { background: var(--warm); color: #fff; }
      .btn-call:hover { background: var(--warm-dark); }
      .btn-quote { border-color: var(--blue); color: var(--blue); background: #fff; }
      .btn-quote:hover { background: var(--sky); }
      .btn-light { background: #fff; color: var(--navy); }
      .btn-outline-light { border-color: #fff; color: #fff; }
      a:focus-visible, .btn:focus-visible { outline: 3px solid var(--warm); outline-offset: 2px; }

      main { display: block; }
      .section { padding: 64px 0; }
      .section-soft { background: var(--soft); }
      .eyebrow { font-size: 1rem; font-weight: 600; color: var(--warm-dark); margin-bottom: 6px; }
      .lead { font-size: 1.15rem; color: var(--muted); }
      .section-head { max-width: 720px; margin-bottom: 32px; }

      .page-hero { background: #fff; padding: 48px 0 36px; border-bottom: 1px solid var(--line); position: relative; }
      .page-hero::after { content: ""; position: absolute; left: 0; bottom: -4px; width: min(420px, 60%); height: 7px; background: var(--hot); box-shadow: 0 11px 0 var(--cold); border-radius: 0 7px 7px 0; }
      .page-hero h1 { font-size: clamp(2.1rem, 5vw, 3.4rem); line-height: 1.04; }
      .page-hero .lead { max-width: 720px; }

      .grid { display: grid; gap: 20px; }
      .grid-2 { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
      .grid-3 { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
      .grid-4 { grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
      .card { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 24px; display: flex; flex-direction: column; gap: 6px; }
      .card p { color: var(--muted); }
      .card .more { margin-top: auto; font-weight: 700; text-decoration: none; }

      .tick-list { list-style: none; padding: 0; margin: 0 0 1.2em; display: grid; gap: 8px; }
      .tick-list li { padding-left: 28px; position: relative; }
      .tick-list li::before { content: ""; position: absolute; left: 4px; top: 0.45em; width: 12px; height: 7px; border-left: 3px solid var(--blue); border-bottom: 3px solid var(--blue); transform: rotate(-45deg); }

      .steps { counter-reset: step; display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); list-style: none; padding: 0; margin: 0; }
      .steps li { counter-increment: step; background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 22px; }
      .steps li::before { content: counter(step); display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--navy); color: #fff; font-weight: 700; margin-bottom: 10px; }
      .steps h3 { margin-bottom: 4px; }
      .steps p { color: var(--muted); margin: 0; }

      .faq { display: grid; border-top: 2px solid var(--navy); }
      .faq details { border-bottom: 1px solid var(--line); padding: 16px 4px; }
      .faq summary { font-weight: 700; cursor: pointer; color: var(--navy); }
      .faq details p { margin: 10px 0 0; color: var(--muted); }

      .cta-band { background: var(--navy); color: #e6eef6; padding: 56px 0; text-align: center; }
      .cta-band h2 { color: #fff; }
      .cta-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 18px; }

      .area-chips { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 0; }
      .area-chips li { background: #fff; border: 1px solid var(--line); border-radius: 99px; padding: 6px 14px; font-weight: 600; }

      .price-box { border: 2px solid var(--blue); border-radius: 10px; padding: 20px 24px; max-width: 420px; margin-bottom: 1.5em; }
      .price-box p { margin: 0; }
      .price-label { font-weight: 700; color: var(--navy); }
      .price { font-family: var(--display); font-size: 2.6rem; font-weight: 700; color: var(--blue); line-height: 1.1; }
      .price-note { color: var(--muted); font-size: 0.95rem; margin-top: 6px !important; }
      .review-grid { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
      .review { margin: 0; background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 22px; display: flex; flex-direction: column; gap: 10px; }
      .review-score { margin: 0; color: var(--muted); font-size: 0.95rem; }
      .review-score strong { font-family: var(--display); font-size: 1.6rem; color: var(--warm); }
      .review blockquote { margin: 0; font-size: 1.05rem; color: var(--ink); }
      .review figcaption { margin-top: auto; display: flex; flex-direction: column; font-size: 0.9rem; color: var(--muted); }
      .review-job { font-weight: 700; color: var(--navy); }
      .review-source { margin-top: 18px; color: var(--muted); font-size: 0.95rem; }
      .note { background: var(--sky); border-left: 4px solid var(--blue); padding: 16px 20px; border-radius: 6px; }

      .site-footer { background: #0c2238; color: #c4d3e1; padding: 48px 0 24px; font-size: 0.95rem; }
      .site-footer a { color: #fff; text-decoration: none; }
      .site-footer a:hover { text-decoration: underline; }
      .site-footer ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
      .footer-grid { display: grid; gap: 28px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
      .footer-logo { display: block; height: 72px; width: auto; margin-bottom: 12px; }
      .footer-brand { font-family: var(--display); font-size: 1.35rem; font-weight: 700; color: #fff; margin-bottom: 6px; }
      .footer-head { font-weight: 700; color: #fff; margin-bottom: 8px; }
      .gas-safe-line { font-weight: 700; color: #fff; }
      .footer-base { border-top: 1px solid #23405c; margin-top: 32px; padding-top: 16px; font-size: 0.85rem; }

      /* ---------- Services dropdown ---------- */
      .main-nav { align-items: center; }
      .has-menu { position: relative; display: flex; align-items: center; }
      .menu-link { display: inline-flex; align-items: center; gap: 4px; }
      .caret { width: 12px; height: 12px; transition: transform 0.2s ease; }
      .menu-toggle { display: none; }
      .services-menu {
        position: absolute; top: calc(100% + 14px); left: -18px; z-index: 40; width: 270px;
        background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 8px;
        box-shadow: 0 18px 40px rgba(18, 50, 79, 0.16);
        display: grid; gap: 2px;
        opacity: 0; visibility: hidden; transform: translateY(8px);
        transition: opacity 0.18s ease, transform 0.18s ease, visibility 0s linear 0.18s;
      }
      .services-menu::before { content: ""; position: absolute; left: 0; right: 0; top: -16px; height: 16px; }
      .services-menu a { display: block; padding: 10px 12px; border-radius: 8px; color: var(--navy); font-weight: 600; text-decoration: none; }
      .services-menu a:hover, .services-menu a:focus-visible { background: var(--sky); }
      .services-menu strong { color: var(--navy); font-size: 0.98rem; }
      .services-menu span { color: var(--muted); font-size: 0.86rem; font-weight: 400; line-height: 1.4; }
      .services-menu { width: 310px; }
      .services-menu .menu-item { display: flex; align-items: center; gap: 12px; padding: 8px 10px; opacity: 0; transform: translateX(-10px); transition: opacity 0.25s ease, transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), background-color 0.15s ease; }
      .services-menu .menu-item > span:last-child { transition: transform 0.2s ease, color 0.15s ease; }
      .services-menu .menu-item:hover > span:last-child, .services-menu .menu-item:focus-visible > span:last-child { transform: translateX(3px); color: var(--blue); }
      .has-menu.open .menu-item, .has-menu:focus-within .menu-item { opacity: 1; transform: none; }
      .services-menu .menu-item:nth-child(2) { transition-delay: 0.03s; }
      .services-menu .menu-item:nth-child(3) { transition-delay: 0.06s; }
      .services-menu .menu-item:nth-child(4) { transition-delay: 0.09s; }
      .services-menu .menu-item:nth-child(5) { transition-delay: 0.12s; }
      .services-menu .menu-item:nth-child(6) { transition-delay: 0.15s; }
      .services-menu .menu-item:nth-child(7) { transition-delay: 0.18s; }
      .services-menu .menu-all { color: var(--blue); font-weight: 700; border-top: 1px solid var(--line); border-radius: 0 0 8px 8px; margin-top: 4px; }
      .has-menu.open .services-menu,
      .has-menu:focus-within .services-menu { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
      .has-menu.open .caret { transform: rotate(180deg); }
      @media (hover: hover) and (min-width: 761px) {
        .has-menu:hover .services-menu { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
        .has-menu:hover .menu-item { opacity: 1; transform: none; }
        .has-menu:hover .caret { transform: rotate(180deg); }
      }
      @media (max-width: 760px) {
        .services-menu, .menu-toggle, .menu-link .caret { display: none !important; }
      }

      /* ---------- Numbers strip ---------- */
      .stats { background: var(--navy); color: #dbe8f4; padding-block: 28px; }
      .stats-inner { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; text-align: center; }
      .stat { display: flex; flex-direction: column; gap: 2px; }
      .stat strong { font-family: var(--display); font-size: clamp(2rem, 5vw, 2.8rem); line-height: 1; color: #fff; font-variant-numeric: tabular-nums; }
      .stat:nth-child(1) strong { color: #ff8a3d; }
      .stat:nth-child(2) strong { color: #f06a7a; }
      .stat:nth-child(3) strong { color: #a98be0; }
      .stat:nth-child(4) strong { color: #4cc3f5; }
      .stat > span { font-size: 0.92rem; }
      @media (max-width: 640px) { .stats-inner { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 22px; } }

      /* ---------- Hot and cold pipes (signature element) ---------- */
      .pipes { position: relative; height: 22px; }
      .pipes span { position: absolute; left: 0; right: 0; height: 7px; border-radius: 7px; transform-origin: left center; }
      .pipes .hot { top: 0; background: var(--hot); }
      .pipes .cold { bottom: 0; background: var(--cold); }
      .pipes span::after { content: ""; position: absolute; right: 14%; top: -3px; width: 12px; height: 13px; border-radius: 3px; background: inherit; filter: brightness(0.82); }
      .pipes .cold::after { right: 22%; }
      .pipes-hero span { animation: pipeIn 1.1s cubic-bezier(0.6, 0, 0.2, 1) both; }
      .pipes-hero .cold { animation-delay: 0.18s; }
      @keyframes pipeIn { from { transform: scaleX(0); } to { transform: scaleX(1); } }

      /* "How a job works" laid out along a pipe run */
      .route { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; counter-reset: step; position: relative; }
      .route::before { content: ""; position: absolute; left: 0; right: 0; top: 17px; height: 7px; border-radius: 7px; background: linear-gradient(90deg, var(--hot), var(--cold)); }
      .route li { counter-increment: step; position: relative; padding-top: 58px; }
      .route li::before { content: counter(step); position: absolute; top: 0; left: 0; width: 40px; height: 40px; border-radius: 50%; background: #fff; border: 4px solid var(--navy); display: grid; place-items: center; font-family: var(--display); font-weight: 700; font-size: 1.15rem; color: var(--navy); box-sizing: border-box; }
      .route h3 { margin-bottom: 4px; }
      .route p { color: var(--muted); margin: 0; }
      @media (max-width: 760px) {
        .route { grid-template-columns: 1fr; gap: 26px; padding-left: 56px; }
        .route::before { left: 17px; right: auto; top: 0; bottom: 0; width: 7px; height: auto; background: linear-gradient(180deg, var(--hot), var(--cold)); }
        .route li { padding-top: 4px; }
        .route li::before { left: -56px; }
      }

      /* ---------- Motion ---------- */
      .btn { transition: transform 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease; }
      .btn:hover { transform: translateY(-2px); box-shadow: 0 6px 16px rgba(18, 50, 79, 0.18); }
      .card, .review, .steps li { transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease; }
      a.card:hover, .review:hover, .steps li:hover { transform: translateY(-3px); box-shadow: 0 10px 24px rgba(18, 50, 79, 0.1); border-color: var(--blue); }
      .btn-call { position: relative; }
      .btn-call::after { content: ""; position: absolute; inset: -2px; border-radius: 10px; pointer-events: none; animation: callPulse 2.8s ease-out infinite; }
      @keyframes callPulse {
        0% { box-shadow: 0 0 0 0 rgba(224, 101, 26, 0.5); }
        70% { box-shadow: 0 0 0 12px rgba(224, 101, 26, 0); }
        100% { box-shadow: 0 0 0 0 rgba(224, 101, 26, 0); }
      }
      @keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
      @keyframes slideIn { from { opacity: 0; transform: translateX(22px); } to { opacity: 1; transform: none; } }
      .page-hero .container > * { animation: rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
      .hero-copy > :nth-child(2), .page-hero .container > :nth-child(2) { animation-delay: 0.08s; }
      .hero-copy > :nth-child(3), .page-hero .container > :nth-child(3) { animation-delay: 0.16s; }
      .hero-copy > :nth-child(4), .page-hero .container > :nth-child(4) { animation-delay: 0.24s; }
      .hero-copy > :nth-child(n+5) { animation-delay: 0.32s; }
      .hero-facts li { animation: slideIn 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
      .hero-facts li:nth-child(1) { animation-delay: 0.25s; }
      .hero-facts li:nth-child(2) { animation-delay: 0.35s; }
      .hero-facts li:nth-child(3) { animation-delay: 0.45s; }
      .hero-facts li:nth-child(4) { animation-delay: 0.55s; }
      .js-motion .reveal { opacity: 0; transform: translateY(18px); transition: opacity 0.6s ease, transform 0.6s ease, box-shadow 0.2s ease, border-color 0.2s ease; }
      .js-motion .reveal.in { opacity: 1; transform: none; }
      .js-motion .reveal.in:hover { transition-delay: 0s !important; }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation: none !important; transition: none !important; }
        .js-motion .reveal { opacity: 1; transform: none; }
      }

      .sticky-call { display: none; }
      .btn-whatsapp { background: #25d366; color: #fff; border-color: #25d366; }
      .btn-whatsapp:hover { background: #1ebe5b; border-color: #1ebe5b; color: #fff; }
      .wa-float { position: fixed; right: 18px; bottom: 18px; z-index: 31; display: inline-flex; align-items: center; gap: 8px; background: #25d366; color: #fff; font-weight: 700; text-decoration: none; padding: 12px 18px 12px 14px; border-radius: 99px; box-shadow: 0 10px 28px rgba(18, 50, 79, 0.25); transition: transform 0.15s ease, box-shadow 0.15s ease; }
      .wa-float:hover { transform: translateY(-2px); box-shadow: 0 14px 32px rgba(18, 50, 79, 0.3); color: #fff; }
      .wa-float svg { flex: none; }
      @media print { .wa-float { display: none; } }
      @media (max-width: 1180px) and (min-width: 761px) {
        .main-nav { gap: 14px; font-size: 0.95rem; }
      }
      @media (max-width: 1040px) and (min-width: 761px) {
        .main-nav { gap: 11px; font-size: 0.9rem; }
        .brand img { height: 60px; }
      }
      @media (max-width: 980px) and (min-width: 761px) {
        .main-nav { order: 3; width: 100%; justify-content: center; gap: 16px; font-size: 0.95rem; padding-bottom: 4px; }
        .brand img { height: 60px; }
      }
      @media (max-width: 760px) {
        .brand img { height: 60px; }
        .main-nav { order: 3; width: 100%; gap: 12px; flex-wrap: nowrap; overflow-x: auto; font-size: 0.88rem; padding-bottom: 4px; }
        .main-nav a { white-space: nowrap; }
        .header-actions .btn-call { display: none; }
        .topbar-areas { display: none; }
        .sticky-call {
          display: block; position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
          background: var(--warm); color: #fff; text-align: center; font-weight: 700;
          padding: 14px 16px calc(14px + env(safe-area-inset-bottom, 0px)); text-decoration: none;
        }
        body { padding-bottom: 56px; }
        .wa-float { bottom: calc(68px + env(safe-area-inset-bottom, 0px)); right: 14px; padding: 13px; }
        .wa-float span { display: none; }
        .section { padding: 44px 0; }
      }
    </style>
    <script is:inline>
      (function () {
        if (!("IntersectionObserver" in window)) return;
        if (window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        var els = document.querySelectorAll(".section .section-head, .section .h-head, .section .card, .review, .steps li, .route li, .price-list li, .area-chips, .faq details, .price-box, .pricebox, .tick-list li, .gallery li, .brand-list, .emergency-inner, .h-featured, .h-more-reviews figure, .h-tidy-photos img, .h-split-col, .trait");
        if (!els.length) return;
        document.documentElement.classList.add("js-motion");
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
          });
        }, { rootMargin: "0px 0px -8% 0px" });
        els.forEach(function (el, i) {
          el.classList.add("reveal");
          el.style.transitionDelay = (i % 4) * 80 + "ms";
          io.observe(el);
        });
        // count the numbers up when they scroll into view
        var counters = document.querySelectorAll("[data-count]");
        var cio = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            cio.unobserve(e.target);
            var el = e.target, end = parseInt(el.getAttribute("data-count"), 10), t0 = null, dur = 1400;
            function step(ts) {
              if (!t0) t0 = ts;
              var p = Math.min(1, (ts - t0) / dur), eased = 1 - Math.pow(1 - p, 3);
              el.textContent = String(Math.round(end * eased));
              if (p < 1) requestAnimationFrame(step);
            }
            el.textContent = "0";
            requestAnimationFrame(step);
          });
        }, { threshold: 0.6 });
        counters.forEach(function (el) { cio.observe(el); });
        window.addEventListener("beforeprint", function () { els.forEach(function (el) { el.classList.add("in"); }); });
      })();
    </script>
    <script is:inline>
      (function () {
        document.querySelectorAll(".has-menu").forEach(function (wrap) {
          var btn = wrap.querySelector(".menu-toggle");
          function set(open) { wrap.classList.toggle("open", open); btn.setAttribute("aria-expanded", String(open)); }
          btn.addEventListener("click", function (e) {
            e.stopPropagation();
            var opening = !wrap.classList.contains("open");
            document.querySelectorAll(".has-menu.open").forEach(function (w) { if (w !== wrap) { w.classList.remove("open"); w.querySelector(".menu-toggle").setAttribute("aria-expanded", "false"); } });
            set(opening);
          });
          document.addEventListener("click", function (e) { if (!wrap.contains(e.target)) set(false); });
          document.addEventListener("keydown", function (e) { if (e.key === "Escape") { set(false); } });
        });
      })();
    </script>
