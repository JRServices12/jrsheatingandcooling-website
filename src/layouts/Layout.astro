---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const phone = "[business phone number]";
const phoneHref = "tel:[phone number, digits only, e.g. +441234567890]";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | JR's Heating and Cooling</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-7HP2LCWEXM"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-7HP2LCWEXM');
</script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/">JR's Heating and Cooling</a>
        <nav class="main-nav">
          <a href="/services">Services</a>
          <a href="/areas">Areas Covered</a>
          <a href="/guides">Guides</a>
          <a href="/about">About</a>
          <a href="/reviews">Reviews</a>
          <a href="/contact">Contact</a>
        </nav>
        <a class="call-button" href={phoneHref}>Call {phone}</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <a class="sticky-call" href={phoneHref}>Call now: {phone}</a>

    <footer class="site-footer">
      <p>JR's Heating and Cooling &middot; Serving [service area / towns] &middot; {phone} &middot; [business email]</p>
      <p><a href="/contact">Contact</a> &middot; <a href="/reviews">Reviews</a></p>
    </footer>

    <style>
      :root {
        --brand-blue: #1b3a5c;
        --brand-orange: #e0651a;
        --text: #1a1a1a;
        --bg: #ffffff;
        --muted: #5a5a5a;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        color: var(--text);
        background: var(--bg);
        line-height: 1.55;
      }
      a { color: var(--brand-blue); }
      .site-header {
        background: var(--brand-blue);
        color: white;
      }
      .header-inner {
        max-width: 1100px;
        margin: 0 auto;
        padding: 1rem 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .brand {
        color: white;
        font-weight: 700;
        text-decoration: none;
        font-size: 1.1rem;
      }
      .main-nav {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
      }
      .main-nav a {
        color: white;
        text-decoration: none;
        font-size: 0.95rem;
      }
      .main-nav a:hover { text-decoration: underline; }
      .call-button {
        background: var(--brand-orange);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        white-space: nowrap;
      }
      main {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem;
      }
      .sticky-call {
        display: none;
      }
      @media (max-width: 640px) {
        .call-button { display: none; }
        .sticky-call {
          display: block;
          position: fixed;
          bottom: 0;
          left: 0;
          right: 0;
          background: var(--brand-orange);
          color: white;
          text-align: center;
          padding: 0.9rem;
          font-weight: 700;
          text-decoration: none;
          z-index: 10;
        }
        main { padding-bottom: 5rem; }
      }
      .site-footer {
        background: #f4f4f4;
        color: var(--muted);
        text-align: center;
        padding: 1.5rem 1rem;
        font-size: 0.9rem;
      }
      h1 { color: var(--brand-blue); }
      .lead { font-size: 1.15rem; color: var(--muted); }
      .card-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 1.25rem;
        margin: 1.5rem 0;
      }
      .card {
        border: 1px solid #e5e5e5;
        border-radius: 8px;
        padding: 1.25rem;
      }
      .card h3 { margin-top: 0; }
      .placeholder {
        background: #fff8e6;
        border: 1px dashed #e0a800;
        border-radius: 6px;
        padding: 1rem;
        margin: 1.5rem 0;
        font-size: 0.95rem;
      }
    </style>
  </body>
</html>
