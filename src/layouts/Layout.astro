---
import { business, services, serviceHref, reviewSource } from "../data/business.js";
import { towns } from "../data/towns.js";
import Accreditations from "../components/Accreditations.astro";
import ServiceIcon from "../components/ServiceIcon.astro";
import { accreditationScope } from "../data/accreditation-scope.js";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const pageTitle = title === "Home"
  ? `${business.name} | Boiler, Heating & Air Conditioning in ${business.region}`
  : `${title} | ${business.name}`;
const canonical = new URL(Astro.url.pathname, business.url).href;
// Air con pages show only the F-Gas logo; boiler and heating pages show only Gas Safe.
const accScope = accreditationScope(Astro.url.pathname);
const accText = accScope === "air" ? "REFCOM F-Gas certified" : accScope === "gas" ? "Gas Safe registered" : "Gas Safe registered · REFCOM F-Gas certified";
// "Quick price" opens the quote tool with this page's job already picked.
const pageService = services.find((s) => serviceHref(s) === Astro.url.pathname);
const quoteHref = pageService?.quoteJob ? `/quote/?job=${pageService.quoteJob}` : Astro.url.pathname === "/boilers/" ? "/quote/?job=boiler" : "/quote/";

// Links that sit under "More" in the menu (shown in a row on phones).
const moreLinks = [
  { href: "/about/", label: "About us" },
  { href: "/areas/", label: "Areas we cover" },
  { href: "/blog/", label: "Advice and blog" },
  { href: "/faq/", label: "FAQ" },
  { href: "/contact/", label: "Contact" },
];

// Extra pages shown in the Services menu without a card of their own.
const extraServiceLinks = [
  { href: "/cp12-certificate/", label: "CP12 certificate for landlords", icon: "landlord-gas-safety-certificates" },
  { href: "/emergency-boiler-repair/", label: "Emergency boiler repair", icon: "emergency-boiler-repair" },
];

// Structured data so Google can link the site to the Business Profile.
const schema = {
  "@context": "https://schema.org",
  "@type": "HVACBusiness",
  name: business.name,
  url: business.url,
  telephone: business.phoneHref.replace("tel:", ""),
  email: business.email,
  openingHours: "Mo-Fr 08:00-17:00",
  brand: business.brands.map((b) => ({ "@type": "Brand", name: b })),
  description: `Gas Safe registered boiler, heating and air conditioning company covering ${business.region}.`,
  areaServed: business.areaGroups.flatMap((g) => g.towns.map((t) => ({ "@type": "Place", name: `${t}, ${g.county}` }))),
  address: { "@type": "PostalAddress", addressRegion: "London", addressCountry: "GB" },
  knowsAbout: services.map((s) => s.title),
  sameAs: [business.googleUrl, reviewSource.url].filter(Boolean),
};
const caret = '<path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>';
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Google Analytics only loads after the visitor accepts analytics cookies.
      (function () {
        var ID = "G-7HP2LCWEXM", KEY = "jrs-cookie-consent";
        function load() {
          if (window.__jrsGaLoaded) return;
          window.__jrsGaLoaded = true;
          var s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtag/js?id=" + ID;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          gtag("js", new Date());
          gtag("config", ID);
        }
        var choice = null;
        try { choice = localStorage.getItem(KEY); } catch (e) {}
        if (choice === "accepted") load();
        window.jrsConsent = { KEY: KEY, load: load, choice: choice };
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:image" content={new URL("/og-image.jpg", business.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${business.name}: boilers, heating and air conditioning in ${business.region}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Inter:wght@400;500;600&display=swap" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <div class="topbar">
      <div class="container topbar-inner">
        <span>{accText}<span class="topbar-extra"> · {business.hoursShort} · Breakdowns {business.breakdowns}</span></span>
        <span class="topbar-logos">
          {accScope !== "air" && <a href="https://www.gassaferegister.co.uk/" target="_blank" rel="noopener" title="Check us on the Gas Safe Register"><img class="topbar-logo" src="/logos/gas-safe.png" alt="Gas Safe registered" width="27" height="30" /></a>}
          {accScope !== "gas" && <img class="topbar-logo" src="/logos/f-gas.png" alt="REFCOM F-Gas certified" width="76" height="30" />}
        </span>
      </div>
    </div>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label={`${business.name} home`}>
          <img src="/logo.svg" alt={business.name} width="190" height="84" />
        </a>
        <nav class="main-nav" aria-label="Main">
          <div class="has-menu">
            <a href="/services/" class="menu-link" aria-haspopup="true">Services<svg class="caret" viewBox="0 0 12 12" aria-hidden="true" set:html={caret} /></a>
            <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="services-menu" aria-label="Show services">
              <svg viewBox="0 0 12 12" aria-hidden="true" set:html={caret} />
            </button>
            <div class="services-menu" id="services-menu">
              {services.map((s) => (
                <a class="menu-item" href={serviceHref(s)}><ServiceIcon slug={s.slug} size={20} small /><span>{s.title}</span></a>
              ))}
              {extraServiceLinks.map((l) => <a class="menu-item" href={l.href}><ServiceIcon slug={l.icon} size={20} small /><span>{l.label}</span></a>)}
              <a class="menu-all" href="/services/">All services</a>
            </div>
          </div>
          <div class="has-menu">
            <a href="/boilers/" class="menu-link" aria-haspopup="true">Boilers<svg class="caret" viewBox="0 0 12 12" aria-hidden="true" set:html={caret} /></a>
            <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="boilers-menu" aria-label="Show boiler services">
              <svg viewBox="0 0 12 12" aria-hidden="true" set:html={caret} />
            </button>
            <div class="services-menu" id="boilers-menu">
              {services.filter((s) => s.boiler).map((s) => (
                <a class="menu-item" href={serviceHref(s)}><ServiceIcon slug={s.slug} size={20} small /><span>{s.title}</span></a>
              ))}
              <a class="menu-item" href="/emergency-boiler-repair/"><ServiceIcon slug="emergency-boiler-repair" size={20} small /><span>Emergency boiler repair</span></a>
              <a class="menu-all" href="/boilers/">All about boilers</a>
            </div>
          </div>
          <a href="/air-conditioning/">Air con</a>
          <a href="/quote/">Prices</a>
          <a href="/reviews/">Reviews</a>
          <a href="/work/">Our work</a>
          <div class="has-menu more-wrap">
            <button type="button" class="menu-toggle more-toggle" aria-expanded="false" aria-controls="more-menu">More<svg class="caret" viewBox="0 0 12 12" aria-hidden="true" set:html={caret} /></button>
            <div class="services-menu more-menu" id="more-menu">
              {moreLinks.map((l) => (
                <>
                  <a class="menu-item" href={l.href}><span>{l.label}</span></a>
                  {l.href === "/areas/" && towns.map((t) => <a class="menu-item" href={`/areas/${t.slug}/`}><ServiceIcon slug="location" size={20} small /><span>{t.name}</span></a>)}
                </>
              ))}
            </div>
          </div>
          {moreLinks.map((l) => <a class="more-inline" href={l.href}>{l.label}</a>)}
        </nav>
        <div class="header-actions">
          <a class="btn btn-call" href={business.phoneHref}>Call {business.phone}</a>
          <a class="btn btn-quote btn-free" href={quoteHref}>Quick price</a>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <a class="sticky-call" href={business.phoneHref}>Call now: {business.phone}</a>
    <a class="wa-float" href={`https://wa.me/${business.whatsapp}?text=${encodeURIComponent("Hi JRS, I found you on your website.")}`} target="_blank" rel="noopener" aria-label="Message JRS on WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg><span>WhatsApp</span></a>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <img class="footer-logo" src="/logo-white.svg" alt={business.name} width="180" height="80" />
          <p>Boiler, heating and air conditioning specialists based in {business.base}, covering {business.region}. Tidy work, every job.</p>
          <p class="gas-safe-line">{accText.replace(" · ", " and ")}</p>
          <Accreditations variant="footer" />
        </div>
        <div>
          <p class="footer-head">Services</p>
          <ul>
            {services.map((s) => <li><a href={serviceHref(s)}>{s.title}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="footer-head">Areas</p>
          <p class="footer-areas">{business.areaGroups.map((g) => g.name).join(" and ")}</p>
          <p class="footer-areas">{towns.map((t, i) => <>{i > 0 && ", "}<a href={`/areas/${t.slug}/`}>{t.name}</a></>)}</p>
          <p class="footer-areas"><a href="/areas/">See every town we cover</a></p>
          <p class="footer-head" style="margin-top:16px">Help and advice</p>
          <p class="footer-areas"><a href="/blog/">Blog: your questions answered</a></p>
          <p class="footer-areas"><a href="/faq/">FAQ</a></p>
        </div>
        <div>
          <p class="footer-head">Contact</p>
          <ul>
            <li><a href={business.phoneHref}>{business.phone}</a></li>
            <li><a href={`mailto:${business.email}`}>{business.email}</a></li>
            <li>Open {business.hoursShort}</li>
            <li>Breakdowns: {business.breakdowns}, just call</li>
            <li><a href={business.googleUrl} target="_blank" rel="noopener">Find us on Google</a></li>
            <li><a href={`https://wa.me/${business.whatsapp}`} target="_blank" rel="noopener">WhatsApp us</a></li>
            <li><a href="/quote/">Get a quick price</a></li>
          </ul>
        </div>
      </div>
      <div class="container footer-base">
        <span>&copy; {new Date().getFullYear()} {business.name}</span>
        <span class="footer-legal"><a href="/privacy/">Privacy and cookies</a><button type="button" class="cookie-settings" data-cookie-open>Cookie settings</button></span>
      </div>
    </footer>

    <div class="cookie-banner" id="cookie-banner" role="region" aria-label="Cookie choice" hidden>
      <div class="cookie-inner">
        <p>We'd like to use analytics cookies to see how people find and use this site, so we can improve it. They stay off unless you accept. <a href="/privacy/">Privacy and cookies</a></p>
        <div class="cookie-actions">
          <button type="button" class="btn btn-quote" data-cookie="rejected">Reject</button>
          <button type="button" class="btn btn-quote cookie-accept" data-cookie="accepted">Accept</button>
        </div>
      </div>
    </div>
    <script is:inline>
      (function () {
        var c = window.jrsConsent, banner = document.getElementById("cookie-banner");
        if (!c || !banner) return;
        function show() { banner.hidden = false; }
        if (c.choice !== "accepted" && c.choice !== "rejected") show();
        banner.querySelectorAll("[data-cookie]").forEach(function (b) {
          b.addEventListener("click", function () {
            var v = b.getAttribute("data-cookie"), was = c.choice;
            try { localStorage.setItem(c.KEY, v); } catch (e) {}
            c.choice = v;
            banner.hidden = true;
            if (v === "accepted") { c.load(); return; }
            if (was === "accepted") {
              // Remove Google Analytics cookies set earlier, then reload without them.
              document.cookie.split(";").forEach(function (k) {
                var name = k.split("=")[0].trim();
                if (/^_ga/.test(name)) {
                  var host = location.hostname.replace(/^www\./, "");
                  ["", "; domain=." + host, "; domain=" + host].forEach(function (d) {
                    document.cookie = name + "=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/" + d;
                  });
                }
              });
              location.reload();
            }
          });
        });
        document.querySelectorAll("[data-cookie-open]").forEach(function (b) { b.addEventListener("click", show); });
      })();
    </script>

    <style is:global>
      :root {
        /* Quiet confidence palette */
        --navy: #0F2A44;
        --navy-deep: #0A1E31;
        --brass: #C9A46A;
        --brass-text: #8A6A2F;
        --copper: #B8501A;
        --copper-dark: #9A4316;
        --paper: #F7F4EE;
        --stone: #F2EEE6;
        /* older names, kept so every page picks up the new palette */
        --blue: var(--navy);
        --sky: var(--stone);
        --warm: var(--copper);
        --warm-dark: var(--copper-dark);
        --hot: var(--copper);
        --cold: var(--brass);
        --ink: #1A2330;
        --muted: #5A6470;
        --line: #E4DED3;
        --bg: var(--paper);
        --soft: #FFFFFF;
        --display: "Newsreader", Georgia, "Times New Roman", serif;
        --body: "Inter", "Segoe UI", system-ui, sans-serif;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        font-family: var(--body);
        font-size: 17px;
        line-height: 1.6;
        color: var(--ink);
        background: var(--bg);
      }
      img { max-width: 100%; height: auto; }
      a { color: var(--navy); text-underline-offset: 3px; }
      a:hover { color: var(--copper); }
      h1, h2, h3 { font-family: var(--display); font-weight: 500; line-height: 1.1; text-wrap: balance; color: var(--navy); margin: 0 0 0.5em; letter-spacing: -0.005em; }
      h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); }
      h2 { font-size: clamp(1.8rem, 3.6vw, 2.6rem); }
      h3 { font-size: 1.45rem; }
      p { margin: 0 0 1em; }
      .container { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
      .narrow { max-width: 780px; }

      .topbar { background: var(--navy-deep); color: #B9C6D3; font-size: 0.82rem; }
      .topbar-inner { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-top: 7px; padding-bottom: 7px; }
      .topbar-logos { display: inline-flex; align-items: center; gap: 8px; flex: none; }
      .topbar-logos a { display: block; line-height: 0; }
      .topbar-logo { display: block; height: 26px; width: auto; background: #fff; border-radius: 4px; padding: 3px 6px; box-sizing: content-box; }

      .site-header { background: #fff; border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 20; }
      .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 12px 28px; padding-top: 12px; padding-bottom: 12px; flex-wrap: wrap; }
      .brand { display: flex; align-items: center; text-decoration: none; flex-shrink: 0; }
      .brand img { display: block; height: 58px; width: auto; }
      .main-nav { display: flex; align-items: center; gap: 26px; font-size: 0.94rem; font-weight: 500; }
      .main-nav a, .main-nav .more-toggle { color: var(--ink); text-decoration: none; }
      .main-nav a:hover, .main-nav .more-toggle:hover { color: var(--copper); }
      .header-actions { display: flex; gap: 10px; align-items: center; }

      .btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; text-decoration: none; font-weight: 600; font-size: 0.95rem; padding: 0 22px; border-radius: 2px; border: 1px solid transparent; white-space: nowrap; transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease; }
      .btn-call { background: var(--copper); color: #fff; }
      .btn-call:hover { background: var(--copper-dark); color: #fff; }
      .btn-quote { border-color: var(--navy); color: var(--navy); background: transparent; }
      .btn-quote:hover { background: var(--navy); color: #fff; }
      .btn-light { background: #fff; color: var(--navy); }
      .btn-outline-light { border-color: var(--brass); color: #fff; }
      .btn-outline-light:hover { background: var(--brass); color: var(--navy-deep); }
      .btn-outline { border-color: var(--navy); color: var(--navy); background: transparent; }
      a:focus-visible, .btn:focus-visible, button:focus-visible { outline: 3px solid var(--brass); outline-offset: 2px; }

      main { display: block; }
      .section { padding: 88px 0; }
      .section-soft { background: var(--soft); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
      .eyebrow { font-size: 0.78rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--brass-text); margin-bottom: 12px; }
      .eyebrow a { color: inherit; }
      .lead { font-size: 1.15rem; color: var(--muted); }
      .section-head { max-width: 720px; margin-bottom: 36px; }

      .page-hero { background: var(--paper); padding: 72px 0 56px; border-bottom: 1px solid var(--line); }
      .page-hero h1 { font-size: clamp(2.4rem, 5vw, 3.8rem); line-height: 1.04; max-width: 20ch; }
      .page-hero h1::after { content: ""; display: block; width: 120px; height: 1px; background: var(--brass); margin-top: 26px; }
      .page-hero .lead { max-width: 720px; }
      .cta-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; margin-top: 18px; }

      .grid { display: grid; gap: 20px; }
      .grid-2 { grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
      .grid-3 { grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
      .grid-4 { grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
      .card { background: #fff; border: 1px solid var(--line); border-top: 3px solid var(--navy); border-radius: 0; padding: 28px; display: flex; flex-direction: column; gap: 6px; }
      .card h3 { font-size: 1.5rem; }
      .card p { color: var(--muted); }
      .card .more { margin-top: auto; font-weight: 600; text-decoration: none; color: var(--navy); }
      .card .more::after { content: " →"; }

      .tick-list { list-style: none; padding: 0; margin: 0 0 1.2em; display: grid; gap: 10px; }
      .tick-list li { padding-left: 28px; position: relative; }
      .tick-list li::before { content: ""; position: absolute; left: 4px; top: 0.5em; width: 11px; height: 6px; border-left: 2px solid var(--brass-text); border-bottom: 2px solid var(--brass-text); transform: rotate(-45deg); }

      .steps { counter-reset: step; display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); list-style: none; padding: 0; margin: 0; }
      .steps li { counter-increment: step; background: #fff; border: 1px solid var(--line); padding: 24px; }
      .steps li::before { content: counter(step, decimal-leading-zero); display: block; font-family: var(--display); font-size: 1.1rem; color: var(--brass-text); margin-bottom: 8px; }
      .steps h3 { margin-bottom: 4px; }
      .steps p { color: var(--muted); margin: 0; }

      .faq { display: grid; border-top: 1px solid var(--navy); }
      .faq details { border-bottom: 1px solid var(--line); padding: 18px 4px; }
      .faq summary { font-weight: 600; cursor: pointer; color: var(--navy); }
      .faq details p { margin: 10px 0 0; color: var(--muted); }

      .cta-band { background: var(--navy-deep); color: #B9C6D3; padding: 72px 0; text-align: center; }
      .cta-band h2 { color: #fff; font-weight: 400; }

      .area-chips { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 0; }
      .area-chips li { background: #fff; border: 1px solid var(--line); border-radius: 99px; padding: 6px 14px; font-weight: 500; }

      .price-box { background: #fff; border: 1px solid var(--line); border-top: 3px solid var(--navy); padding: 24px 28px; max-width: 420px; margin-bottom: 1.5em; }
      .price-box p { margin: 0; }
      .price-label { font-weight: 600; color: var(--navy); }
      .price { font-family: var(--display); font-size: 2.8rem; font-weight: 500; color: var(--navy); line-height: 1.1; }
      .price-note { color: var(--muted); font-size: 0.95rem; margin-top: 6px !important; }
      .review-grid { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
      .review { margin: 0; background: #fff; border: 1px solid var(--line); border-top: 1px solid var(--brass); padding: 26px; display: flex; flex-direction: column; gap: 10px; }
      .review-score { margin: 0; color: var(--muted); font-size: 0.95rem; }
      .review-score strong { font-family: var(--display); font-size: 1.7rem; font-weight: 500; color: var(--brass-text); }
      .review blockquote { margin: 0; font-size: 1.02rem; color: var(--ink); }
      .review figcaption { margin-top: auto; display: flex; flex-direction: column; font-size: 0.9rem; color: var(--muted); }
      .review-job { font-weight: 600; color: var(--navy); }
      .review-source { margin-top: 18px; color: var(--muted); font-size: 0.95rem; }
      .note { background: var(--stone); border: 1px solid var(--line); padding: 18px 22px; }

      .site-footer { background: var(--navy-deep); color: #9FB0C2; padding: 64px 0 28px; font-size: 0.95rem; }
      .site-footer a { color: #fff; text-decoration: none; }
      .site-footer a:hover { text-decoration: underline; color: #fff; }
      .site-footer ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
      .footer-grid { display: grid; gap: 32px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
      .footer-logo { display: block; height: 72px; width: auto; margin-bottom: 14px; }
      .footer-head { font-weight: 600; color: #fff; margin-bottom: 10px; }
      .footer-areas { margin-bottom: 6px; }
      .gas-safe-line { font-weight: 600; color: #fff; }
      .footer-base { border-top: 1px solid #22384F; margin-top: 36px; padding-top: 18px; font-size: 0.85rem; display: flex; flex-wrap: wrap; gap: 10px 24px; justify-content: space-between; }
      .footer-legal { display: inline-flex; gap: 20px; flex-wrap: wrap; }
      .cookie-settings { font: inherit; color: #fff; background: none; border: 0; padding: 0; cursor: pointer; }
      .cookie-settings:hover { text-decoration: underline; }

      /* ---------- Cookie choice ---------- */
      .cookie-banner { position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 50; display: flex; justify-content: center; pointer-events: none; }
      .cookie-banner[hidden] { display: none; }
      .cookie-inner { pointer-events: auto; max-width: 760px; width: 100%; display: flex; gap: 16px 24px; align-items: center; justify-content: space-between; flex-wrap: wrap; background: #fff; border: 1px solid var(--line); border-top: 2px solid var(--brass); padding: 18px 22px; box-shadow: 0 18px 40px rgba(10, 30, 49, 0.18); }
      .cookie-inner p { margin: 0; font-size: 0.92rem; color: var(--ink); flex: 1 1 320px; }
      .cookie-actions { display: flex; gap: 10px; }
      .cookie-actions .btn { min-height: 44px; }
      .cookie-accept { background: var(--navy); color: #fff; }
      .cookie-accept:hover { background: var(--navy-deep); }
      @media (max-width: 760px) { .cookie-banner { bottom: calc(64px + env(safe-area-inset-bottom, 0px)); left: 10px; right: 10px; } }

      /* ---------- Dropdown menus ---------- */
      .has-menu { position: relative; display: flex; align-items: center; }
      .menu-link { display: inline-flex; align-items: center; gap: 4px; }
      .caret { width: 12px; height: 12px; transition: transform 0.2s ease; }
      .menu-toggle { display: none; }
      .more-toggle { display: inline-flex; align-items: center; gap: 4px; font: inherit; background: none; border: 0; padding: 10px 0; cursor: pointer; }
      .more-inline { display: none; }
      .services-menu {
        position: absolute; top: calc(100% + 14px); left: -18px; z-index: 40; width: 310px;
        background: #fff; border: 1px solid var(--line); border-top: 2px solid var(--brass); padding: 8px;
        box-shadow: 0 18px 40px rgba(10, 30, 49, 0.12);
        display: grid; gap: 2px;
        opacity: 0; visibility: hidden; transform: translateY(8px);
        transition: opacity 0.18s ease, transform 0.18s ease, visibility 0s linear 0.18s;
      }
      .more-menu { left: auto; right: -12px; width: 230px; }
      .services-menu::before { content: ""; position: absolute; left: 0; right: 0; top: -16px; height: 16px; }
      .services-menu a { display: flex; align-items: center; gap: 12px; padding: 10px 12px; color: var(--navy); font-weight: 500; text-decoration: none; }
      .services-menu a:hover, .services-menu a:focus-visible { background: var(--paper); color: var(--copper); }
      .services-menu a.sub { padding: 6px 12px 6px 44px; font-size: 0.92rem; font-weight: 400; color: var(--muted); }
      .more-menu a.sub { padding-left: 28px; }
      .services-menu .menu-all { font-weight: 600; border-top: 1px solid var(--line); margin-top: 4px; }
      .has-menu.open .services-menu,
      .has-menu:focus-within .services-menu { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
      .has-menu.open .caret { transform: rotate(180deg); }
      /* Touch screens and phones: tap the arrow to open a menu (hovering isn't possible). */
      @media (max-width: 760px), (hover: none) {
        .menu-link .caret { display: none; }
        .menu-toggle:not(.more-toggle) { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; margin-left: 2px; background: none; border: 0; padding: 0; cursor: pointer; color: var(--navy); }
        .menu-toggle svg { width: 12px; height: 12px; transition: transform 0.2s ease; }
        .has-menu.open .menu-toggle svg { transform: rotate(180deg); }
      }
      @media (max-width: 760px) {
        .has-menu { position: static; }
        .services-menu, .more-menu { position: fixed; left: 10px; right: 10px; top: 120px; width: auto; max-height: 68vh; overflow-y: auto; z-index: 45; }
        .services-menu::before { display: none; }
        .services-menu a { padding: 13px 12px; }
        .services-menu a.sub, .more-menu a.sub { padding: 10px 12px 10px 44px; }
      }
      @media (hover: hover) and (min-width: 761px) {
        .has-menu:hover .services-menu { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
        .has-menu:hover .caret { transform: rotate(180deg); }
      }

      /* ---------- Numbers strip ---------- */
      .stats { background: var(--navy); color: #B9C6D3; padding-block: 32px; }
      .stats-inner { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; text-align: center; }
      .stat { display: flex; flex-direction: column; gap: 2px; }
      .stat strong { font-family: var(--display); font-weight: 500; font-size: clamp(2rem, 5vw, 2.8rem); line-height: 1; color: var(--brass); font-variant-numeric: tabular-nums; }
      .stat > span { font-size: 0.92rem; }
      @media (max-width: 640px) { .stats-inner { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 22px; } }

      /* "How a job works" as a numbered line */
      .route { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; counter-reset: step; position: relative; }
      .route::before { content: ""; position: absolute; left: 0; right: 0; top: 19px; height: 1px; background: var(--brass); }
      .route li { counter-increment: step; position: relative; padding-top: 58px; }
      .route li::before { content: counter(step); position: absolute; top: 0; left: 0; width: 40px; height: 40px; border-radius: 50%; background: var(--paper); border: 1px solid var(--navy); display: grid; place-items: center; font-family: var(--display); font-size: 1.15rem; color: var(--navy); }
      .section-soft .route li::before { background: #fff; }
      .route h3 { margin-bottom: 4px; }
      .route p { color: var(--muted); margin: 0; }
      @media (max-width: 760px) {
        .route { grid-template-columns: 1fr; gap: 26px; padding-left: 56px; }
        .route::before { left: 19px; right: auto; top: 0; bottom: 0; width: 1px; height: auto; }
        .route li { padding-top: 4px; }
        .route li::before { left: -56px; }
      }

      /* ---------- Motion ---------- */
      .card, .review, .steps li { transition: border-color 0.2s ease, box-shadow 0.2s ease; }
      a.card:hover, .review:hover, .steps li:hover { box-shadow: 0 12px 28px rgba(10, 30, 49, 0.08); }
      a.card:hover { color: inherit; }
      @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
      .page-hero .container > * { animation: rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
      .page-hero .container > :nth-child(2) { animation-delay: 0.08s; }
      .page-hero .container > :nth-child(3) { animation-delay: 0.16s; }
      .page-hero .container > :nth-child(4) { animation-delay: 0.24s; }
      .js-motion .reveal { opacity: 0; transform: translateY(16px); transition: opacity 0.6s ease, transform 0.6s ease, box-shadow 0.2s ease, border-color 0.2s ease; }
      .js-motion .reveal.in { opacity: 1; transform: none; }
      .js-motion .reveal.in:hover { transition-delay: 0s !important; }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation: none !important; transition: none !important; }
        .js-motion .reveal { opacity: 1; transform: none; }
      }

      .sticky-call { display: none; }
      .btn-whatsapp { background: #25d366; color: #fff; border-color: #25d366; }
      .btn-whatsapp:hover { background: #1ebe5b; border-color: #1ebe5b; color: #fff; }
      .wa-float { position: fixed; right: 18px; bottom: 18px; z-index: 31; display: inline-flex; align-items: center; gap: 8px; background: #25d366; color: #fff; font-weight: 600; text-decoration: none; padding: 12px 18px 12px 14px; border-radius: 99px; box-shadow: 0 10px 28px rgba(10, 30, 49, 0.22); transition: transform 0.15s ease; }
      .wa-float:hover { transform: translateY(-2px); color: #fff; }
      .wa-float svg { flex: none; }
      @media print { .wa-float { display: none; } }

      /* ---------- Header at smaller widths ---------- */
      @media (max-width: 1180px) {
        .main-nav { order: 3; width: 100%; gap: 22px; padding: 10px 0 2px; border-top: 1px solid var(--line); }
      }
      @media (max-width: 760px) {
        .brand img { height: 50px; }
        .main-nav { gap: 18px; flex-wrap: nowrap; overflow-x: auto; font-size: 0.9rem; padding-bottom: 6px; }
        .main-nav a { white-space: nowrap; }
        .more-inline { display: none; }
        .header-actions .btn-call { display: none; }
        .header-actions .btn { min-height: 44px; padding: 0 16px; }
        .topbar-extra { display: none; }
        .sticky-call {
          display: block; position: fixed; left: 0; right: 0; bottom: 0; z-index: 30;
          background: var(--copper); color: #fff; text-align: center; font-weight: 600;
          padding: 14px 16px calc(14px + env(safe-area-inset-bottom, 0px)); text-decoration: none;
        }
        body { padding-bottom: 56px; }
        .wa-float { bottom: calc(68px + env(safe-area-inset-bottom, 0px)); right: 14px; padding: 13px; }
        .wa-float span { display: none; }
        .section { padding: 56px 0; }
        .page-hero { padding: 48px 0 40px; }
      }
    </style>
    <script is:inline>
      (function () {
        if (!("IntersectionObserver" in window)) return;
        if (window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        var els = document.querySelectorAll(".section .section-head, .section .h-head, .section .card, .review, .steps li, .route li, .price-list li, .area-chips, .faq details, .price-box, .pricebox, .tick-list li, .gallery li, .brand-list, .h-path, .h-quote, .h-tidy-photos img, .trait");
        if (!els.length) return;
        document.documentElement.classList.add("js-motion");
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); }
          });
        }, { rootMargin: "0px 0px -8% 0px" });
        els.forEach(function (el, i) {
          el.classList.add("reveal");
          el.style.transitionDelay = (i % 4) * 80 + "ms";
          io.observe(el);
        });
        // count the numbers up when they scroll into view
        var counters = document.querySelectorAll("[data-count]");
        var cio = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            cio.unobserve(e.target);
            var el = e.target, end = parseInt(el.getAttribute("data-count"), 10), t0 = null, dur = 1400;
            function step(ts) {
              if (!t0) t0 = ts;
              var p = Math.min(1, (ts - t0) / dur), eased = 1 - Math.pow(1 - p, 3);
              el.textContent = String(Math.round(end * eased));
              if (p < 1) requestAnimationFrame(step);
            }
            el.textContent = "0";
            requestAnimationFrame(step);
          });
        }, { threshold: 0.6 });
        counters.forEach(function (el) { cio.observe(el); });
        window.addEventListener("beforeprint", function () { els.forEach(function (el) { el.classList.add("in"); }); });
      })();
    </script>
    <script is:inline>
      (function () {
        document.querySelectorAll(".has-menu").forEach(function (wrap) {
          var btn = wrap.querySelector(".menu-toggle");
          if (!btn) return;
          function set(open) { wrap.classList.toggle("open", open); btn.setAttribute("aria-expanded", String(open)); }
          btn.addEventListener("click", function (e) {
            e.stopPropagation();
            var opening = !wrap.classList.contains("open");
            document.querySelectorAll(".has-menu.open").forEach(function (w) { if (w !== wrap) { w.classList.remove("open"); var b = w.querySelector(".menu-toggle"); if (b) b.setAttribute("aria-expanded", "false"); } });
            if (opening && window.innerWidth <= 760) {
              var menu = wrap.querySelector(".services-menu");
              if (menu) menu.style.top = (wrap.getBoundingClientRect().bottom + 6) + "px";
            }
            set(opening);
          });
          document.addEventListener("click", function (e) { if (!wrap.contains(e.target)) set(false); });
          document.addEventListener("keydown", function (e) { if (e.key === "Escape") { set(false); } });
        });
      })();
    </script>
  </body>
</html>
