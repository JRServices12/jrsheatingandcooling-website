---
import Layout from "../layouts/Layout.astro";
import { business } from "../data/business.js";
import ContactForm from "../components/ContactForm.astro";
import InstagramIcon from "../components/InstagramIcon.astro";
---
<Layout title="Contact" description={`Contact ${business.name} for a free quote. Call ${business.phone} or email. Covering ${business.region}.`}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Contact</p>
      <h1>Get in touch</h1>
      <p class="lead">Call, WhatsApp, email{business.formKey && <> or <a href="#message">send us a message</a></>} with what you need and roughly where you are. Or <a href="/quote/">get a rough price in a minute</a> with the quick price tool. Every job gets a free, written quote first.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="grid grid-3" style="grid-template-columns:repeat(auto-fit,minmax(220px,1fr))">
        <div class="card">
          <h3>Call</h3>
          <p>The quickest way to reach us.</p>
          <a class="btn btn-call" href={business.phoneHref} style="align-self:flex-start">{business.phone}</a>
        </div>
        <div class="card">
          <h3>WhatsApp</h3>
          <p>Send a message and photos of the job to {business.whatsappDisplay}, and we'll get back to you.</p>
          <a class="btn btn-whatsapp" href={`https://wa.me/${business.whatsapp}`} target="_blank" rel="noopener" style="align-self:flex-start">WhatsApp us</a>
        </div>
        <div class="card">
          <h3>Email</h3>
          <p>Photos of your boiler or the problem help us quote faster.</p>
          <a href={`mailto:${business.email}`} style="font-weight:700;word-break:break-all">{business.email}</a>
        </div>
        <div class="card">
          <h3>Instagram</h3>
          <p>See our recent jobs and send us a message.</p>
          <a href={business.instagramUrl} target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:10px;font-weight:700;align-self:flex-start;text-decoration:none">
            <InstagramIcon size={34} id="ig-contact" />
            <span>@jrs.heatingandcooling</span>
          </a>
        </div>
      </div>
      <div class="note" style="margin-top:24px">
        <p style="margin:0"><strong>Opening hours:</strong> {business.hours}. Boiler broken down or no heating? We cover breakdowns {business.breakdowns}, so call and we'll get to you as quickly as we can.</p>
      </div>
      <p style="margin-top:24px">Based in {business.base} and covering North Kent, {business.reach}. <a href="/areas/">See the areas we cover</a>.</p>
    </div>
  </section>
  {(business.formKey || import.meta.env.DEV) && (
    <section class="section section-soft" id="message">
      <div class="container contact-form-wrap">
        <div>
          <p class="eyebrow">Send a message</p>
          <h2>Prefer to write it down?</h2>
          <p class="lead">Tell us what you need and we'll get back to you with a price or a time to visit. For a breakdown, it's quicker to call.</p>
        </div>
        <ContactForm />
      </div>
    </section>
  )}
</Layout>

<style>
  .contact-form-wrap { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 56px; align-items: start; }
  @media (max-width: 900px) { .contact-form-wrap { grid-template-columns: 1fr; gap: 28px; } }
</style>
