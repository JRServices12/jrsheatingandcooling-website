---
import Layout from "../../layouts/Layout.astro";
import { business, services, serviceHref } from "../../data/business.js";
import ServiceIcon from "../../components/ServiceIcon.astro";
---
<Layout title="Services" description={`Boiler servicing, repairs, new boilers, power flushing, radiators, underfloor heating, landlord gas safety certificates and air conditioning across ${business.region}.`}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Services</p>
      <h1>Boilers, heating and air conditioning</h1>
      <p class="lead">We're Gas Safe registered and F-Gas certified, and every job gets a free written quote first.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="grid grid-2">
        {services.map((s) => (
          <a class="card" href={serviceHref(s)} style="text-decoration:none;color:inherit">
            <ServiceIcon slug={s.slug} size={34} />
            <h3>{s.title}</h3>
            <p>{s.short}</p>
            <span class="more">Find out more</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
