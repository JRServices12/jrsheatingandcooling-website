---
import Layout from "../../layouts/Layout.astro";
import { business } from "../../data/business.js";
---
<Layout title="Areas Covered" description={`${business.name} is based in ${business.base} and covers Dartford and North Kent, including Crayford, Swanley, Greenhithe and Gravesend.`}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Areas covered</p>
      <h1>South East London &amp; North Kent</h1>
      <p class="lead">Based in {business.base} and covering North Kent, {business.reach}. Boiler servicing, repairs, new boilers, landlord certificates and air conditioning.</p>
    </div>
  </section>
  {business.areaGroups.map((g, i) => (
    <section class:list={["section", { "section-soft": i % 2 === 1 }]} style="padding-block:40px">
      <div class="container">
        <h2>{g.name}</h2>
        <ul class="area-chips" style="margin-top:14px">
          {g.towns.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </section>
  ))}
  <section class="section">
    <div class="container narrow">
      <p class="note">Don't see your town? If you're nearby, I may still be able to help. Call {business.phone} and ask.</p>
    </div>
  </section>
</Layout>
