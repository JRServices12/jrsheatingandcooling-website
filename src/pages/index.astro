---
import Layout from "../layouts/Layout.astro";
import { business, reviews, reviewSource, photos } from "../data/business.js";
import { quotePrices as P } from "../data/quote-prices.js";

const gbp = (n) => "£" + Number(n).toLocaleString("en-GB");
const photo = (file) => photos.find((p) => p.file === file);
const tidy = [
  { ...photo("bathroom-freestanding-bath"), src: "/images/work/bathroom-freestanding-bath.jpg" },
  { ...photo("boiler-install-cupboard"), src: "/images/work/boiler-install-cupboard-sm.jpg" },
  { ...photo("radiators-fitted"), src: "/images/work/radiators-fitted-sm.jpg" },
];
const review = (area, date) => reviews.find((x) => x.area === area && x.date === date);
const featured = review("SE7", "13 December 2023");
const more = [review("DA16", "21 February 2024"), review("SE18", "9 November 2023")];

// The three routes into the site, one per kind of customer.
const paths = [
  {
    title: "I own my home",
    text: "Yearly boiler service, a breakdown, or a new boiler. Honest advice on repair or replace.",
    cta: `Service from ${gbp(P.boilerService)}`,
    href: "/boilers/",
  },
  {
    title: "I'm a landlord",
    text: "Gas safety certificates (CP12) for one property or several, with a reminder before each one is due.",
    cta: `Certificate ${gbp(P.landlordCert)}`,
    href: "/services/landlord-gas-safety-certificates/",
  },
  {
    title: "I'm renovating",
    text: "New heating systems, underfloor heating and air conditioning, planned around your build, with a photo report at first fix, second fix and handover.",
    cta: "Talk to us about your project",
    href: "/contact/",
    brass: true,
  },
];
---
<Layout
  title="Home"
  description={`Gas Safe registered boiler, heating and air conditioning company based in ${business.base} and covering North Kent. Boiler servicing, repairs, new boilers, landlord gas safety certificates and air con. Free quotes.`}
>
  <section class="h-hero">
    <div class="container">
      <p class="eyebrow">Gas Safe registered · {business.region}</p>
      <h1>Boilers, heating and air con. What do you need help with?</h1>
      <p class="h-lead">Pick the one that sounds like you and we'll take you straight to the right place. Every job is priced in writing before any work starts.</p>
      <div class="h-paths">
        {paths.map((p) => (
          <a class:list={["h-path", { "h-path-brass": p.brass }]} href={p.href}>
            <span class="h-path-title">{p.title}</span>
            <span class="h-path-text">{p.text}</span>
            <span class="h-path-cta">{p.cta} →</span>
          </a>
        ))}
      </div>
      <p class="h-breakdown"><strong>No heating or hot water?</strong> Call <a href={business.phoneHref}>{business.phone}</a>, evenings and weekends included, and we'll get to you as quickly as we can. <a href="/emergency-boiler-repair/">More about breakdown cover</a>.</p>
    </div>
  </section>

  <section class="h-proof" aria-label="Reviews summary">
    <div class="container h-proof-inner">
      <p class="h-proof-score"><strong>{reviewSource.perfect}</strong><span>of our {reviewSource.total} Checkatrade reviews<br />are a perfect 10</span></p>
      <p class="h-proof-quote">“Jordan is very diligent and thorough. Compared to other Plumbers he was very polite and did not make a mess in the house.” <span>Boiler service, SE18</span></p>
    </div>
  </section>

  <section class="h-tidy">
    <div class="container h-tidy-inner">
      <div class="h-tidy-photos">
        {tidy.map((p, i) => (
          <img class={`t${i + 1}`} src={p.src} alt={p.caption} loading="lazy" />
        ))}
      </div>
      <div class="h-tidy-copy">
        <p class="eyebrow">The standard</p>
        <h2>Tidy work, even where you can't see it</h2>
        <p class="h-muted">The thing we're proudest of is how neat the job is when we leave. Pipework is run straight and clipped properly, whether it's on show or hidden behind a cupboard. From a period bathroom to a rental flat, the finish is the same.</p>
        <ol class="h-standards">
          <li><span>01</span>Gas Safe registered, with ID shown when we arrive.</li>
          <li><span>02</span>The engineer who quotes your job is the one who does it. Nothing is passed to subcontractors.</li>
          <li><span>03</span>A clear written price first, so there are no surprises at the end.</li>
          <li><span>04</span>Dust sheets down, and your home left clean.</li>
        </ol>
        <p><a class="h-link" href="/work/">See more of our work →</a></p>
      </div>
    </div>
  </section>

  <section class="h-reviews">
    <div class="container">
      <div class="h-more-reviews">
        {[featured, ...more].map((r) => (
          <figure class="h-quote">
            <blockquote>“{r.text}”</blockquote>
            <figcaption>{r.area}, {r.date} · {r.score}/10</figcaption>
          </figure>
        ))}
      </div>
      <p class="h-after"><a class="h-link" href="/reviews/">Read more reviews →</a> <span>or</span> <a href={business.googleReviewUrl} target="_blank" rel="noopener">leave us a Google review</a></p>
    </div>
  </section>

  <section class="h-emergency" aria-label="Breakdowns">
    <div class="container">
      <div class="h-emergency-box">
        <div>
          <h2>No heating or hot water?</h2>
          <p>Call us, evenings and weekends included, and we'll get to you as quickly as we can. Breakdowns, leaks and boilers that won't fire up go first.</p>
          <p class="gas-warn"><strong>Smell gas?</strong> Open windows, don't use switches or flames, and call the National Gas Emergency line on <a href="tel:0800111999">0800 111 999</a> straight away.</p>
        </div>
        <a class="btn btn-call" href={business.phoneHref}>Call {business.phone}</a>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container">
      <h2>Looking for heating engineers you can trust in your home?</h2>
      <p>Call for a chat, or send a few photos on WhatsApp for a price.</p>
      <div class="cta-actions">
        <a class="btn btn-call" href={business.phoneHref}>Call {business.phone}</a>
        <a class="btn btn-outline-light" href={`https://wa.me/${business.whatsapp}`} target="_blank" rel="noopener">WhatsApp us</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero: three routes into the site */
  .h-hero { padding: 88px 0 96px; }
  .h-hero h1 { font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.05; margin: 0 0 16px; max-width: 20ch; }
  .h-lead { font-size: 1.18rem; color: var(--muted); max-width: 40em; margin-bottom: 44px; }
  .h-paths { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .h-path { display: flex; flex-direction: column; gap: 10px; min-height: 240px; padding: 32px; background: #fff; border: 1px solid var(--line); border-top: 3px solid var(--navy); color: inherit; text-decoration: none; transition: box-shadow 0.2s ease, border-color 0.2s ease; }
  .h-path-brass { border-top-color: var(--brass); }
  .h-path:hover { color: inherit; box-shadow: 0 14px 32px rgba(10, 30, 49, 0.09); }
  .h-path-title { font-family: var(--display); font-size: 1.9rem; line-height: 1.15; color: var(--navy); }
  .h-path-text { color: var(--muted); }
  .h-path-cta { margin-top: auto; font-weight: 600; color: var(--navy); }
  .h-path:hover .h-path-cta { color: var(--copper); }
  .h-breakdown { margin: 28px 0 0; color: var(--muted); }
  .h-breakdown strong { color: var(--ink); }
  .h-breakdown a { font-weight: 600; }
  @media (max-width: 900px) {
    .h-paths { grid-template-columns: 1fr; }
    .h-path { min-height: 0; padding: 26px; }
    .h-hero { padding: 56px 0 64px; }
  }

  /* Proof strip */
  .h-proof { background: var(--navy); color: #B9C6D3; }
  .h-proof-inner { display: flex; flex-wrap: wrap; gap: 24px 56px; align-items: center; justify-content: space-between; padding-top: 40px; padding-bottom: 40px; }
  .h-proof p { margin: 0; }
  .h-proof-score { display: flex; align-items: baseline; gap: 14px; color: #fff; }
  .h-proof-score strong { font-family: var(--display); font-weight: 500; font-size: 3.5rem; line-height: 1; color: var(--brass); }
  .h-proof-quote { max-width: 580px; font-family: var(--display); font-style: italic; font-size: 1.45rem; line-height: 1.35; color: #fff; }
  .h-proof-quote span { display: block; margin-top: 6px; font-family: var(--body); font-style: normal; font-size: 0.88rem; color: #B9C6D3; }

  /* Tidy work */
  .h-tidy { background: #fff; border-bottom: 1px solid var(--line); padding: 96px 0; }
  .h-tidy-inner { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 64px; align-items: center; }
  .h-tidy-photos { display: grid; grid-template-columns: 1.3fr 1fr; grid-template-rows: repeat(2, minmax(0, 1fr)); gap: 12px; height: 560px; }
  .h-tidy-photos img { width: 100%; height: 100%; min-height: 0; object-fit: cover; display: block; }
  .h-tidy-photos .t1 { grid-row: 1 / 3; }
  .h-muted { color: var(--muted); }
  .h-standards { list-style: none; margin: 0 0 28px; padding: 0; display: grid; gap: 14px; }
  .h-standards li { display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: 8px; }
  .h-standards span { font-family: var(--display); color: var(--brass-text); }
  .h-link { font-weight: 600; }
  @media (max-width: 900px) {
    .h-tidy { padding: 64px 0; }
    .h-tidy-inner { grid-template-columns: 1fr; gap: 36px; }
    .h-tidy-photos { height: 400px; }
  }

  /* Reviews */
  .h-reviews { padding: 96px 0; }
  .h-featured { margin: 0 0 56px; max-width: 900px; }
  .h-featured blockquote { margin: 0; font-family: var(--display); font-size: clamp(1.5rem, 3vw, 2.3rem); line-height: 1.3; color: var(--navy); }
  .h-featured figcaption { margin-top: 18px; color: var(--muted); font-size: 0.95rem; }
  .h-more-reviews { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 40px; }
  .h-quote { margin: 0; padding-top: 20px; border-top: 1px solid var(--brass); }
  .h-quote blockquote { margin: 0; }
  .h-quote figcaption { margin-top: 10px; color: var(--muted); font-size: 0.9rem; }
  .h-after { margin-top: 40px; color: var(--muted); }
  .h-after span { margin: 0 6px; }
  @media (max-width: 900px) { .h-reviews { padding: 64px 0; } }

  /* Breakdowns */
  .h-emergency { padding: 0 0 72px; }
  .h-emergency-box { display: flex; gap: 24px 48px; align-items: center; justify-content: space-between; flex-wrap: wrap; padding: 36px 40px; background: #fff; border: 1px solid var(--navy); }
  .h-emergency-box > div { max-width: 700px; }
  .h-emergency h2 { font-size: clamp(1.6rem, 3vw, 2rem); margin-bottom: 8px; }
  .h-emergency p { color: var(--muted); margin: 0 0 12px; }
  .gas-warn { font-size: 0.92rem; margin: 0 !important; }
  .gas-warn strong { color: var(--ink); }
  .gas-warn a { font-weight: 600; }
  @media (max-width: 600px) { .h-emergency-box { padding: 26px 22px; } }
</style>
